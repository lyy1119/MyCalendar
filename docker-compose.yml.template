# Convenience wrapper for the Dockerfile.
#
# Copy it first, then edit the copy: the live docker-compose.yml is gitignored,
# so local settings (host paths, timezone, registry) never reach the repository
# and never conflict on a pull.
#
#   cp docker-compose.yml.template docker-compose.yml
#   docker compose up -d --build
#
# Where the database lives is the one thing worth thinking about here; see
# "数据库放到宿主机" in the README. In short: mount the /data directory, not the
# .db file.

services:
  mycalendar:
    # Default: use the image CI publishes to ghcr.io.
    #
    # `missing` means: use the local copy if there is one, otherwise pull. Set
    # `always` to re-check the registry on every start, or `never` to stay
    # offline and rely on whatever is already local.
    #
    # Pulling needs access to the package; when that is not available the build
    # block below is used instead.
    image: ghcr.io/lyy1119/mycalendar:latest
    pull_policy: missing

    # Kept so that a pull which cannot succeed -- no registry access, not logged
    # in, package still private -- can fall back to building locally:
    #
    #   make deploy               # try the pull, build if it fails
    #   docker compose up -d --build   # build unconditionally
    #
    # Compose has no policy meaning "pull, and build if that fails", which is
    # exactly why `make deploy` exists.
    build:
      context: .
      args:
        # Stamped into the binary and reported by /healthz, /api and /help.
        # It is a BUILD-time value, not something the server reads at runtime,
        # which is why it is not named MYCAL_*. Set it inline:
        #   BUILD_VERSION=1.2.3 docker compose up -d --build
        VERSION: ${BUILD_VERSION:-compose}

        # Where the build's `go mod download` and `npm ci` reach the network.
        #
        # The Go default, proxy.golang.org, is unreachable from some networks
        # (mainland China in particular), and the build then fails with a terse
        # `go mod download ... exit code: 1`. Defaulting to a mirror here keeps
        # that from biting; set GOPROXY= to go back to the official proxy.
        GOPROXY: ${GOPROXY:-https://goproxy.cn,direct}

        # If the build host needs a proxy to reach the internet, export it in
        # your shell and it is picked up here. An unset value stays empty, which
        # means "no proxy".
        HTTP_PROXY: ${HTTP_PROXY:-}
        HTTPS_PROXY: ${HTTPS_PROXY:-}
        NO_PROXY: ${NO_PROXY:-}

    container_name: mycalendar
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      # Docker-managed named volume. Data survives restarts and rebuilds, and
      # lives under /var/lib/docker/volumes/mycalendar-data.
      - mycalendar-data:/data

      # --- OR bind-mount a host directory -------------------------------
      # Comment out the line above and uncomment one of these to keep the
      # database somewhere you can see, back up and copy directly.
      #
      # Mount the whole /data directory, never just mycalendar.db. SQLite runs
      # in WAL mode, so it keeps mycalendar.db-wal and mycalendar.db-shm beside
      # the database, and those must be on the same filesystem as it. Mounting
      # only the file would strand the WAL inside the container, where it is
      # lost when the container is recreated -- taking committed data with it.
      #
      # - /srv/mycalendar:/data
      #
      # On SELinux hosts (RHEL, Fedora, CentOS) append :Z so the container is
      # allowed to write to the directory:
      # - /srv/mycalendar:/data:Z
      #
      # A relative path also works and keeps everything inside the project:
      # - ./data:/data
    environment:
      MYCAL_ADDR: ":8080"
      # Inside the container the database always lives here; move the host side
      # by changing the volume above rather than this path.
      MYCAL_DB: "/data/mycalendar.db"
      MYCAL_TZ: "${MYCAL_TZ:-Asia/Shanghai}"
      MYCAL_WEEK_START: "${MYCAL_WEEK_START:-monday}"
      MYCAL_LOG_LEVEL: "${MYCAL_LOG_LEVEL:-info}"
      # This service has no authentication. Keep it on a trusted network, and
      # narrow this if a browser front end is ever served from elsewhere.
      MYCAL_CORS_ORIGINS: "${MYCAL_CORS_ORIGINS:-*}"
    # The image has no shell, so a healthcheck must invoke the binary itself.
    # It cannot curl; check from the host instead:
    #   curl -fsS http://127.0.0.1:8080/healthz
    healthcheck:
      disable: true

volumes:
  mycalendar-data:
